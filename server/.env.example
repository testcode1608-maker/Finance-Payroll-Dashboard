# Copy this file to .env and set your local PostgreSQL password there.
# Never commit server/.env.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hani-model-1
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_SSL=false
# Local admin login. Change ADMIN_PASSWORD before exposing the API to a network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hanihani
